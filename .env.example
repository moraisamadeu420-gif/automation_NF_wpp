# ============================================================
# .env.example — copie para .env e preencha os valores
# cp .env.example .env
# ============================================================

# ── Aplicação ────────────────────────────────────────────────
APP_NAME=NFSe Bot
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ── Servidor ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Banco de dados ───────────────────────────────────────────
# SQLite (padrão, sem instalação):
DATABASE_URL=sqlite+aiosqlite:///./data/nfse.db
# PostgreSQL (produção):
# DATABASE_URL=postgresql+asyncpg://usuario:senha@host:5432/nfse

# ── Evolution API (WhatsApp) ─────────────────────────────────
EVOLUTION_URL=https://sua-evolution-api.up.railway.app
EVOLUTION_API_KEY=sua_api_key_aqui
EVOLUTION_INSTANCE=spx-nfse

# ── Browser / Playwright ─────────────────────────────────────
BROWSER_HEADLESS=false     # false = abre o navegador visível (útil para depurar)
BROWSER_SLOW_MO=800        # atraso em ms entre ações (800 é seguro)
BROWSER_TIMEOUT=30000

# ── Modo de teste ────────────────────────────────────────────
DRY_RUN=false         # true = simula emissão sem abrir o Playwright

# ── Segurança ────────────────────────────────────────────────
WEBHOOK_SECRET=             # opcional: valida assinatura HMAC dos webhooks
INTERNAL_API_KEY=           # opcional: protege endpoints internos
# ENCRYPTION_KEY é gerada automaticamente na primeira execução
# Copie o valor gerado para cá para não perder senhas criptografadas
ENCRYPTION_KEY=

# ── Política de retry ────────────────────────────────────────
RETRY_ATTEMPTS=3
RETRY_DELAY=2.0

# ── Diretórios de saída ──────────────────────────────────────
OUTPUT_DIR=./output
LOGS_DIR=./logs
DATA_DIR=./data
