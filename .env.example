# ============================================================
# .env.example — copie para .env e preencha os valores
# cp .env.example .env
# ============================================================

# ── Aplicação ────────────────────────────────────────────────
APP_NAME=NFSe Bot
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ── Servidor ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Banco de dados ───────────────────────────────────────────
# SQLite (padrão, sem instalação):
DATABASE_URL=sqlite+aiosqlite:///./data/nfse.db
# PostgreSQL (produção):
# DATABASE_URL=postgresql+asyncpg://usuario:senha@host:5432/nfse

# ── Evolution API (WhatsApp) ─────────────────────────────────
EVOLUTION_URL=https://sua-evolution-api.up.railway.app
EVOLUTION_API_KEY=sua_api_key_aqui
EVOLUTION_INSTANCE=spx-nfse

# ── Browser / Playwright ─────────────────────────────────────
BROWSER_HEADLESS=false     # false = abre o navegador visível (útil para depurar)
BROWSER_SLOW_MO=800        # atraso em ms entre ações (800 é seguro)
BROWSER_TIMEOUT=30000

# ── Modo de teste ────────────────────────────────────────────
DRY_RUN=false         # true = simula emissão sem abrir o Playwright

# ── Segurança ────────────────────────────────────────────────
WEBHOOK_SECRET=             # opcional: valida assinatura HMAC dos webhooks
INTERNAL_API_KEY=           # opcional: protege endpoints internos
# ENCRYPTION_KEY é gerada automaticamente na primeira execução
# Copie o valor gerado para cá para não perder senhas criptografadas
ENCRYPTION_KEY=

# ── Mercado Pago ─────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=   # token de produção da sua conta MP
MERCADOPAGO_WEBHOOK_SECRET= # opcional: valida assinatura HMAC das notificações MP
MERCADOPAGO_SKIP_SIGNATURE=true  # apenas em desenvolvimento — mude para false em produção
# Link do plano recorrente (checkout compartilhado). Ativação manual pelo admin.
# Ex: https://www.mercadopago.com.br/subscriptions/checkout?preapproval_plan_id=SEU_PLAN_ID
MERCADOPAGO_PLAN_URL=
SUBSCRIPTION_PRICE=19.90
SUBSCRIPTION_DAYS=30
TRIAL_DAYS=15
# URL pública do bot — necessária para o MP enviar confirmação de pagamento
# Em desenvolvimento: cole aqui a URL do ngrok (ex: https://abc123.ngrok-free.app)
# Em produção: use seu domínio real (ex: https://meubot.com)
BOT_PUBLIC_URL=

# ── Admin ────────────────────────────────────────────────────
# Número do admin (somente dígitos, ex: 5519971721948)
# Permite comandos: ATIVAR <número> <dias> | BLOQUEAR <número> | STATUS <número>
ADMIN_NUMBER=

# ── Política de retry ────────────────────────────────────────
RETRY_ATTEMPTS=3
RETRY_DELAY=2.0

# ── Diretórios de saída ──────────────────────────────────────
OUTPUT_DIR=./output
LOGS_DIR=./logs
DATA_DIR=./data
